#!/usr/bin/env bash
set -euo pipefail

# Output styling helpers
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log() { echo -e "${BLUE}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }

# 1. Root pre-flight check
if [ "$EUID" -ne 0 ]; then
    error "This script must be run with root/sudo privileges."
    exit 1
fi

# Store the non-root username to configure Podman for them later
INVOKING_USER="${SUDO_USER:-}"

# ==========================================
# STEP 1: STOP & PURGE DOCKER
# ==========================================
log "Beginning Docker teardown..."

# Stop all running containers if Docker daemon is responsive
if systemctl is-active --quiet docker; then
    log "Stopping all running Docker containers..."
    docker container stop $(docker container ls -aq) 2>/dev/null || true
    log "Stopping Docker and containerd services..."
    systemctl stop docker.socket docker containerd || true
fi

# Purge Docker packages
log "Purging Docker-related packages..."
apt purge -y \
    docker-ce \
    docker-ce-cli \
    containerd.io \
    docker-buildx-plugin \
    docker-compose-plugin \
    docker.io \
    docker-doc \
    docker-compose \
    podman-docker || true

log "Autoremoving residual dependencies..."
apt autoremove -y

# Clean up Docker system files, keys, and repositories
log "Removing remaining Docker directories, keys, and sources..."
rm -rf /var/lib/docker /var/lib/containerd
rm -f /etc/apt/sources.list.d/docker.list /etc/apt/sources.list.d/docker.sources
rm -f /etc/apt/keyrings/docker.asc /etc/apt/keyrings/docker.gpg

# ==========================================
# STEP 2: INSTALL PODMAN
# ==========================================
log "Updating package lists..."
apt update

log "Installing Podman and helper utilities..."
# On modern Debian, Podman is natively available in the stable repositories
apt install -y podman buildah skopeo

# ==========================================
# STEP 3: CONFIGURE ROOTLESS PODMAN FOR USER
# ==========================================
if [ -n "$INVOKING_USER" ] && [ "$INVOKING_USER" != "root" ]; then
    log "Configuring subuids/subgids for rootless containers for user: $INVOKING_USER"
    
    # Rootless Podman requires subuid/subgid ranges. Check if they exist, if not, allocate them.
    if ! grep -q "^$INVOKING_USER:" /etc/subuid; then
        echo "$INVOKING_USER:100000:65536" >> /etc/subuid
    fi
    if ! grep -q "^$INVOKING_USER:" /etc/subgid; then
        echo "$INVOKING_USER:100000:65536" >> /etc/subgid
    fi

    # Set up a convenient 'docker' alias in the user's shell profile
    USER_SHELL=$(getent passwd "$INVOKING_USER" | cut -d: -f7)
    SHELL_RC=""
    
    if [[ "$USER_SHELL" == *"zsh" ]]; then
        SHELL_RC="/home/$INVOKING_USER/.zshrc"
    elif [[ "$USER_SHELL" == *"bash" ]]; then
        SHELL_RC="/home/$INVOKING_USER/.bashrc"
    fi

    if [ -n "$SHELL_RC" ] && [ -f "$SHELL_RC" ]; then
        if ! grep -q "alias docker=podman" "$SHELL_RC"; then
            log "Adding 'docker=podman' alias to $SHELL_RC..."
            echo -e "\n# Podman Docker Compatibility Alias\nalias docker=podman" >> "$SHELL_RC"
            chown "$INVOKING_USER":"$INVOKING_USER" "$SHELL_RC"
        fi
    fi
    
    success "Podman has been configured for user '$INVOKING_USER'."
else
    warn "Running as raw root; skipped user-specific rootless configuration."
fi

# ==========================================
# STEP 4: VERIFICATION
# ==========================================
log "Verifying Podman installation..."
podman --version

# Run a rootless container test if an invoking user is present
if [ -n "$INVOKING_USER" ] && [ "$INVOKING_USER" != "root" ]; then
    log "Testing rootless podman execution under user '$INVOKING_USER'..."
    sudo -u "$INVOKING_USER" podman run --rm hello-world || {
        warn "Rootless dry-run failed. This is typical if you are running in a nested VM or LXC container."
    }
else
    log "Testing root podman execution..."
    podman run --rm hello-world
fi

success "Migration complete! Docker has been fully removed, and Podman is installed."
