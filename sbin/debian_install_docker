#!/usr/bin/env bash
set -euo pipefail

# Define color outputs for logging
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

# 1. Ensure the script is run with sudo/root privileges
if [ "$EUID" -ne 0 ]; then
    echo "Please run this script with sudo or as root."
    exit 1
fi

# 2. Uninstall old or conflicting Docker packages
log "Uninstalling old, conflicting Docker packages (if any exist)..."
apt remove -y docker.io docker-doc docker-compose docker-compose-v2 podman-docker containerd runc || true

# 3. Update the Package Index and Install Dependencies
log "Updating package index and installing base dependencies (ca-certificates, curl)..."
apt update
apt install -y ca-certificates curl

# 4. Import Docker's Official GPG Key
log "Importing Docker's official GPG key..."
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc

# 5. Add the Docker APT Repository (configured specifically for Debian 13 "Trixie")
log "Registering the official Docker APT sources list..."
tee /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/debian
Suites: $(. /etc/os-release && echo "$VERSION_CODENAME")
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF

# 6. Install Docker Engine, CLI, and Plugins
log "Updating package lists and installing Docker packages..."
apt update
apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

# 7. Start and Verify the Docker Service
log "Starting and enabling the Docker service..."
systemctl start docker
systemctl enable docker

# Check the active state of Docker
if systemctl is-active --quiet docker; then
    success "Docker service is actively running."
else
    warn "Docker service failed to start automatically. Please check systemctl status docker."
fi

# 8. Configure Non-Root User Access (Optional but Recommended)
if [ -n "$SUDO_USER" ]; then
    log "Adding user '$SUDO_USER' to the 'docker' group to allow passwordless Docker commands..."
    usermod -aG docker "$SUDO_USER"
    success "Successfully added '$SUDO_USER' to the docker group."
    warn "Please log out and log back in (or run 'newgrp docker') for the group membership to take effect."
else
    warn "Could not detect the invoking non-root user. Skipping docker group configuration."
fi

# 9. Final Verification Test
log "Running the hello-world container to verify the installation..."
docker run --rm hello-world

success "Docker installation and verification complete!"
