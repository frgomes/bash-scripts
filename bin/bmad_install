#!/bin/bash -eux

function bmad_install {
  local fullname=$(getent passwd | grep $(whoami) | cut -d: -f5)
  if echo "${fullname}" | grep -q "," ; then
    local firstname=$(echo "${fullname}" | cut -d, -f2 | xargs | cut -d' ' -f1)
  else
    local firstname=$(echo "${fullname}" | cut -d' ' -f1)
  fi

  which npx > /dev/null 2>&1 || ( echo "ERROR: could not find npx" && exit 1 )

  npx bmad-method install \
    --directory "." \
    --output-folder "./_bmad-output" \
    --tools claude-code,cursor,codex,github-copilot,gemini,openclaw,opencode \
    --user-name "${firstname}" \
    --action update \
    --yes
}

bmad_install "$@"
