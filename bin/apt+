#!/bin/bash -eu

# The functions below like __apt+_Debian, apt+_Ubuntu, apt+_openSUSE, etc are meant to
# generalize package naming so that a given name employed in bassh_scripts may correspond
# to one or more packages on a given target operating system.
#
# We do not embrace any naming from any operating system in particular. So, in this way,
# sometimes we embrace a given package name from Debian because it sounds better, sometimes
# we embrace a given package name from openSUSE because it sounds better, sometimes we
# invent our own due to our own reasons.

function __apt+_Debian {
    cat <<EOF
# id : program-or-path : package
wget:wget:apt install -y wget
fd:fdfind:apt install -y fd-find
rg:rg:apt install -y ripgrep
libgmp-dev:/usr/include/gmpxx.h:apt install -y libgmp-dev
libncurses-dev:/usr/include/curses.h:apt install -y libncurses-dev
xz:xzgrep:apt install -y xz-utils
realpath:realpath:apt install -y coreutils
plasma-desktop::apt install -y kde-plasma-desktop
openssl::apt install -y openssl
openssl-devel::apt install -y libssl-dev
sqlite3-devel::apt install -y libsqlite3-dev
build-essential::apt install -y build-essential
clang:clang:apt install -y clang
squashfs::apt install -y squashfs-tools
EOF
}

function __apt+_Ubuntu {
    cat <<EOF
# id : program-or-path : package
fd:fdfind:apt install -y fd-find
rg:rg:apt install -y ripgrep
g++:g++:apt install -y gcc-c++
libgmp-dev:/usr/include/gmpxx.h:apt install -y libgmp-dev
libncurses-dev:/usr/include/curses.h:apt install -y libncurses-dev
xz:xzgrep:apt install -y xz-utils
realpath:realpath:apt install -y coreutils
plasma-desktop::apt install -y kde-plasma-desktop
openssl::apt install -y openssl
openssl-devel::apt install -y libssl-dev
sqlite3-devel::apt install -y libsqlite3-dev
build-essential::apt install -y build-essential
squashfs::apt install -y squashfs-tools
EOF
}

function __apt+_openSUSE {
    cat <<EOF
# id : program-or-path : package
fd:fd:zypper install -y fd
rg:rg:zypper install -y ripgrep
g++:g++:zypper install -y gcc-c++
libgmp-dev:/usr/include/gmpxx.h:zypper install -y libgmpxx4
libncurses-dev:/usr/include/curses.h:zypper install -y ncurses-devel
xz:xzgrep:zypper install -y xz
realpath:realpath:zypper install -y coreutils
plasma-desktop::zypper install -y plasma5-desktop
dbus-x11::zypper install -y dbus-1-x11
network-manager::zypper install -y NetworkManager
xorg::zypper install -y xorg-x11-server
openssl::zypper install -y openssl
openssl-devel::zypper install -y libopenssl-devel
sqlite3-devel::zypper install -y sqlite3-devel
build-essential::zypper install -y -t pattern devel_basis
EOF
}

function __apt+_Fedora {
    cat <<EOF
# id : program-or-path : package
fd:fd:dnf install -y fd
rg:rg:dnf install -y ripgrep
g++:g++:dnf install -y gcc-c++
libgmp-dev:/usr/include/gmpxx.h:dnf install -y libgmpxx4
libncurses-dev:/usr/include/curses.h:dnf install -y ncurses-devel
xz:xzgrep:dnf install -y xz
realpath:realpath:dnf install -y coreutils
plasma-desktop::dnf install -y plasma5-desktop
dbus-x11::dnf install -y dbus-1-x11
network-manager::dnf install -y NetworkManager
xorg::dnf install -y xorg-x11-server
openssl::dnf install -y openssl
openssl-devel::dnf install -y openssl-devel
sqlite3-devel::dnf install -y sqlite3-devel
build-essential::dnf group install -y c-development development-tools
squashfs::dnf install -y squashfs-tools
EOF
}

function apt+ {
    local distro="$(os_release | cut -d: -f1)"
    case "${1}" in
        update)
            shift
            case "${distro}" in
                Debian|Ubuntu) sudo apt    update ;;
                openSUSE)      sudo zypper refresh ;;
                Fedora)        sudo dnf    update ;;
                *)             echo "Unsupported distribution: ${distro}" ; return 1;;
            esac
            ;;
        install)
            shift
            for id in $@ ;do
                local pkg=$(echo ${id} | sed 's/+/\\+/g')
	        if [[ -z "${pkg}" ]] ;then
                    echo "ERROR: apt+ failed to find a description for package: ${id}"
                    exit 1
                else
                    local cmd=$(__apt+_${distro} | grep -E "^${pkg}:" | grep -E -v '(^[ \t]*#)|(^[ \t]*$)' | cut -d: -f3)
                    [[ -z "${cmd}" ]] && \
                        case "${distro}" in
                            Debian|Ubuntu) local cmd="apt install -y ${pkg}" ;;
                            openSUSE)      local cmd="zypper install -y ${pkg}" ;;
                            Fedora)        local cmd="dnf install -y ${pkg}" ;;
                            *)             echo "Unsupported distribution: ${distro}" ; return 1;;
                        esac
                    local obj=$(__apt+_${distro} | grep -E "^${pkg}:" | grep -E -v '(^[ \t]*#)|(^[ \t]*$)' | cut -d: -f2)
                    local obj=${obj:-${id}}
                    case "${distro}" in
                        Debian|Ubuntu) [[ -f ${obj} ]] || which ${obj} >/dev/null 2>&1 || sudo ${cmd} ;;
                        openSUSE)      [[ -f ${obj} ]] || which ${obj} >/dev/null 2>&1 || sudo ${cmd} ;;
                        Fedora)        [[ -f ${obj} ]] || which ${obj} >/dev/null 2>&1 || sudo ${cmd} ;;
                        *)             echo "Unsupported distribution: ${distro}" ; return 1;;
                    esac
		        fi
		        shift
            done
            ;;
        remove)
            shift
            for id in $@ ;do
	            if [[ -z "${pkg}" ]] ;then
		            echo "ERROR: apt+ failed to find a description for package: ${id}"
		            exit 1
		        else
                    local cmd=$(__apt+_${distro} | grep -E "^${pkg}:" | grep -E -v '(^[ \t]*#)|(^[ \t]*$)' | cut -d: -f3)
                    local obj=$(__apt+_${distro} | grep -E "^${pkg}:" | grep -E -v '(^[ \t]*#)|(^[ \t]*$)' | cut -d: -f2)
                    local obj=${obj:-${id}}
                    case "${distro}" in
                        Debian|Ubuntu) sudo $(echo "${cmd}" | sed 's/install/autoremove --purge/') ;;
                        openSUSE)      sudo $(echo "${cmd}" | sed 's/install/remove --clean-deps/') ;;
                        Fedora)        sudo $(echo "${cmd}" | sed 's/install/autoremove/') ;;
                        *)             echo "Unsupported distribution: ${distro}" ; return 1;;
                    esac
		        fi
		        shift
            done
            ;;
        dist-upgrade)
            shift
            case "${distro}" in
                Debian|Ubuntu) sudo apt    upgrade ;;
                openSUSE)      sudo zypper update ;;
                openSUSE)      sudo dnf    upgrade ;;
                *) echo "Unsupported distribution: ${distro}" ; return 1;;
            esac
            ;;
        *)
            echo "Unsupported command: ${1}" ; return 1;;
    esac
}

apt+ $@
