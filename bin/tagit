#!/usr/bin/env bash
# file: tagit
set -euo pipefail

ABS_PATH=false
VERBOSE=false
TARGETS=()

usage() {
  echo "Labels shell scripts, Python, JS, TS, Rust, YAML, TOML, Markdown, and JSONC files with their path."
  echo "Usage: $0 [-f] [-v] <file_or_dir> [file_or_dir ...]"
  echo "Options:"
  echo "  -f          Insert absolute file paths instead of relative file paths (default: relative)."
  echo "  -v          Print resolved paths to stdout."
  echo "  -h, --help  Show this help message."
  exit 1
}

# Parse command-line flags (no stdin support)
while [[ $# -gt 0 ]]; do
  case "$1" in
    -f)
      ABS_PATH=true
      shift
      ;;
    -v)
      VERBOSE=true
      shift
      ;;
    -h|--help)
      usage
      ;;
    --)
      shift
      TARGETS+=("$@")
      break
      ;;
    -*)
      usage
      ;;
    *)
      TARGETS+=("$1")
      shift
      ;;
  esac
done

if [ "${#TARGETS[@]}" -eq 0 ]; then
  usage
fi

log_out() {
  echo "$@"
}

log_err() {
  echo "$@" >&2
}

# Collect files (recursively expanding directories)
FILES=()
for target in "${TARGETS[@]}"; do
  if [ ! -e "$target" ] && [ ! -L "$target" ]; then
    log_err "${target}:::File or directory does not exist."
    continue
  fi

  if [ -d "$target" ]; then
    while IFS= read -r -d '' found_file; do
      FILES+=("$found_file")
    done < <(find -L "$target" -type f -print0 2>/dev/null | sort -z)
  else
    FILES+=("$target")
  fi
done

for file in "${FILES[@]}"; do
  abs_target=$(readlink -f "$file" 2>/dev/null || true)
  if [ -z "$abs_target" ] || [ ! -f "$abs_target" ]; then
    log_err "${file}:::File does not exist."
    continue
  fi

  if [ "$ABS_PATH" = true ]; then
    resolved_path="$abs_target"
  else
    if command -v realpath >/dev/null 2>&1; then
      resolved_path=$(realpath --relative-to="$PWD" "$abs_target" 2>/dev/null || printf '%s' "$abs_target")
    else
      resolved_path=$(python3 -c 'import os, sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))' "$abs_target" "$PWD")
    fi
  fi

  if [ "$VERBOSE" = true ]; then
    log_out "${resolved_path}"
  fi

  filename=$(basename "$abs_target")
  filepath="$resolved_path"
  first_line=$(head -n 1 "$abs_target" 2>/dev/null || true)

  # Detect file type
  file_type=""
  if [[ "$first_line" =~ ^#! ]] || [[ "$filename" =~ \.(sh|bash|zsh|ksh|fish)$ ]]; then
    file_type="shell"
  elif [[ "$filename" =~ \.py$ ]]; then
    file_type="python"
  elif [[ "$filename" =~ \.(js|mjs|cjs)$ ]]; then
    file_type="js"
  elif [[ "$filename" =~ \.(ts|tsx)$ ]]; then
    file_type="ts"
  elif [[ "$filename" =~ \.rs$ ]]; then
    file_type="rust"
  elif [[ "$filename" =~ \.(yaml|yml)$ ]]; then
    file_type="yaml"
  elif [[ "$filename" =~ \.(toml|cfg|conf)$ ]]; then
    file_type="toml"
  elif [[ "$filename" =~ \.(md|markdown)$ ]]; then
    file_type="markdown"
  elif [[ "$filename" =~ \.jsonc$ ]]; then
    file_type="jsonc"
  elif [[ "$filename" =~ \.json$ ]]; then
    log_err "${file}:::Standard JSON skipped (does not support comments)."
    continue
  else
    log_err "${file}:::Not recognized as a supported file type."
    continue
  fi

  # Skip non-text / binary files
  if file -b --mime-type "$abs_target" 2>/dev/null | grep -qvE 'text/|x-empty|xml|json'; then
    log_err "${file}:::Binary file skipped."
    continue
  fi

  # Escape special replacement characters in filepath for sed (\ and &)
  safe_filepath=$(printf '%s' "$filepath" | sed -e 's/\\/\\\\/g' -e 's/&/\\&/g')

  # In-place modification mode per file type (restricted to lines 1-2)
  case "$file_type" in
    shell|python)
      header_line="# file: ${safe_filepath}"
      if head -n 2 "$abs_target" | grep -qE '^# (file|script):'; then
        sed -i -E "1,2s|^# file:.*|${header_line}|" "$abs_target"
        sed -i -E "1,2s|^# script:.*|${header_line}|" "$abs_target"
      elif [[ "$first_line" =~ ^#! ]]; then
        sed -i "1a\\
${header_line}" "$abs_target"
      else
        sed -i "1i\\
${header_line}" "$abs_target"
      fi
      ;;

    js|ts|rust)
      header_line="// file: ${safe_filepath}"
      if head -n 2 "$abs_target" | grep -qE '^//!? (file|script):'; then
        sed -i -E "1,2s|^// file:.*|${header_line}|" "$abs_target"
        sed -i -E "1,2s|^//! file:.*|${header_line}|" "$abs_target"
        sed -i -E "1,2s|^// script:.*|${header_line}|" "$abs_target"
        sed -i -E "1,2s|^//! script:.*|${header_line}|" "$abs_target"
      elif [[ "$first_line" =~ ^#! ]]; then
        sed -i "1a\\
${header_line}" "$abs_target"
      else
        sed -i "1i\\
${header_line}" "$abs_target"
      fi
      ;;

    yaml|toml)
      header_line="# file: ${safe_filepath}"
      if head -n 2 "$abs_target" | grep -qE '^# (file|script):'; then
        sed -i -E "1,2s|^# file:.*|${header_line}|" "$abs_target"
        sed -i -E "1,2s|^# script:.*|${header_line}|" "$abs_target"
      elif [[ "$first_line" =~ ^--- ]]; then
        sed -i "1a\\
${header_line}" "$abs_target"
      else
        sed -i "1i\\
${header_line}" "$abs_target"
      fi
      ;;

    markdown)
      header_line="<!-- file: ${safe_filepath} -->"
      if head -n 2 "$abs_target" | grep -qE '^<!-- (file|script):.*-->'; then
        sed -i -E "1,2s|^<!-- file:.*-->|${header_line}|" "$abs_target"
        sed -i -E "1,2s|^<!-- script:.*-->|${header_line}|" "$abs_target"
      else
        sed -i "1i\\
${header_line}" "$abs_target"
      fi
      ;;

    jsonc)
      header_line="/* file: ${safe_filepath} */"
      if head -n 2 "$abs_target" | grep -qE '^/\* (file|script):.*\*/'; then
        sed -i -E "1,2s|^/\* file:.*\*/|${header_line}|" "$abs_target"
        sed -i -E "1,2s|^/\* script:.*\*/|${header_line}|" "$abs_target"
      else
        sed -i "1i\\
${header_line}" "$abs_target"
      fi
      ;;
  esac
done
