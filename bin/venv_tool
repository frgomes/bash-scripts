#!/bin/bash

#########################################################################################################
# This file is intended to be sourced by a CI server, so that we build and publish all Python projects. #
#########################################################################################################

# NOTES:
#     1. Preferred Python version
#        See status of Python 3.13 releases here: https://peps.python.org/pep-0719/
#        uv may or may not be in sync with the release cadence


# parameters
name=${1}                             # name of the virtual environment to be created
v=${2:-$(python3 -V | cut -d' ' -f2)} # Python version to be installed onto the virtual environment


# install uv :: https://pypi.org/project/uv/
which uv > /dev/null 2>&1 || curl -LsSf https://astral.sh/uv/install.sh | sh
export PATH="$PATH:${HOME}/.local/bin"
uv self update

# install Python3
uv python install ${v}

# create a virtual environment dependent on cpython installed in the previous step
cpython=cpython$(echo ${v} | cut -d'.' -f1-2 | tr -d '.')
venv=${name:-${cpython}}
p=$(uv python list | grep cpython-${v} | grep -v freethreaded | sort | head -1 | sed -E 's/[ \t]+/ /g' | cut -d' ' -f2)
uv venv -v -p ${p} --seed --managed-python ~/.virtualenvs/${venv}



source ~/.virtualenvs/${venv}/bin/activate

# install pip and pipx into your virtual environment
uv pip install pip
uv pip install pipx

# install ruff, hatch and aider :: https://hatch.pypa.io
which ruff  > /dev/null 2>&1 || uv tool install -p ${p} --managed-python ruff
which hatch > /dev/null 2>&1 || uv tool install -p ${p} --managed-python hatch

# adjust PATH
export PATH=${PATH}:${HOME}/.local/bin

# show versions
echo ------------------------------------------------------------------------------------------------------------------------
echo Python environment was set up successfully:
echo VIRTUAL_ENV=${VIRTUAL_ENV}
echo VIRTUAL_ENV_PROMPT=${VIRTUAL_ENV_PROMPT}
python --version
pip --version
echo pipx $(pipx --version)
ruff --version
hatch --version
echo ------------------------------------------------------------------------------------------------------------------------
