#!/bin/bash -eu

function install_azure_binaries {
  local self=$(readlink -f "${BASH_SOURCE[0]}")
  local dir=$(dirname $self)

  which curl >/dev/null 2>&1 || apt+ install curl

  local name=azure
  local group=250
  local releases=https://github.com/Azure/azure-cli/releases
  local latest=${releases}/latest
  local latest="$(curl -I ${latest} 2>/dev/null | fgrep location: | tr -d '[:cntrl:]' | cut -d' ' -f2 | sed -E 's|.*\/azure-cli-(.*)$|\1|')"
  echo "${name}: latest version: ${latest:-(not detected)}" 1>&2
  local default="${AZURE_VERSION:-${latest:-2.67.0}}"
  local version="${1:-${default}}"
  echo "${name}: installing version: ${version}" 1>&2

  local file=azure-cli-${version}-x64.zip
  local url=${releases}/download/azure-cli-${version}/${file}

  local folder=${name}-${version}
  local subfolder=
  local symlinks=${name}
  local bin="${VIRTUAL_ENV:-${HOME}/.local/share/bash-scripts}/bin"
  "${dir}"/bash_install_zip "${url}" "${file}" "${folder}" "(${symlinks})" "${bin}" "${subfolder}"

  local config="${VIRTUAL_ENV:-${HOME}/.local/share/bash-scripts}"/postactivate/postactivate.d/${group}-${name}.sh
  [[ ! -d $(dirname "${config}") ]] && mkdir -p $(dirname "${config}")
  cat <<EOD > "${config}"
#!/bin/bash

export AZURE_VERSION=${version}
export AZURE_HOME=\${TOOLS_HOME:=\$HOME/tools}/${folder}
#export PATH=\${AZURE_HOME}/bin:\${PATH}
EOD
  chmod ugo+x "${config}"
  echo "${config}"
}

function __install_azure {
  self=$(readlink -f "${BASH_SOURCE[0]}"); dir=$(dirname $self)
  grep -E "^function [a-zA-Z0-9]" $self | cut -d' ' -f2 | while read cmd ;do
    $cmd $*
  done
}


if [ $_ != $0 ]; then
  # echo "Script is being sourced: list all functions"
  grep -E "^function [a-zA-Z0-9]" $(readlink -f "${BASH_SOURCE[0]}") | cut -d' ' -f2 | sed 's/()//'
else
  # echo "Script is a subshell: execute last function"
  $(grep -E "^function __" $(readlink -f "${BASH_SOURCE[0]}") | cut -d' ' -f2  | sed 's/()//' | tail -1) "$@"
fi
