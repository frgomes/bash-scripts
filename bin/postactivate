#!/bin/bash

 ##
## NOTE: This script is designed to be sourced
###

function __postactivate {
    local venv="${1}"
    local venv=${venv:-.venv}
    for script in ${venv}/postactivate.d/*.sh ;do
        [[ -x "${script}" ]] && echo "sourcing ${script}" && source "${script}"
    done
}


__postactivate $@
