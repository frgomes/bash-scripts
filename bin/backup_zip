#!/bin/bash -eu

function backup_zip() {
  apt+ install fd
  apt+ install grep
  apt+ install zip

  local now=$(date +%Y%m%d_%H%M%S)
  local cwd=${1:-$(pwd)}

  if [ -d "$cwd" ] ;then
      local dir="$( readlink -f "$cwd" )"
      local dst=${HOME}/backup/archives"${dir}"
      local name="$( basename "$dir" )"
      mkdir -p ${dst} > /dev/null 2>&1
      # echo "$dir" ...
      local archive=${dst}/${now}_${name}.zip
      echo "${archive}"

      find "${dir}" -type f | grep -F -v "${dir}"'./*.iml' | grep -F -v "${dir}"'./.idea/' | grep -F -v "${dir}"'./.hg/' | grep -F -v '/.git/' | grep -F -v '/.lib/' | grep -F -v '/node_modules/' | grep -F -v '/target/' | \
          zip -q -r -@ "${archive}" > /dev/null 2>&1

      # copy to Dropbox, if available
      local replica=${HOME}/Dropbox/Private/backup/"${dst}"
      mkdir -p "${replica}" > /dev/null 2>&1
      if [ $? -eq 0 ] ;then
          cp ${archive} "${replica}"
      fi
  fi
}

backup_zip $*
