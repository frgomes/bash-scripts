#!/bin/bash -eux


function install_emacs_binaries {
  local self=$(readlink -f "${BASH_SOURCE[0]}")
  local dir=$(dirname $self)

  which emacs > /dev/null 2>&1 || apt+ install emacs emacs-vterm emacs-x11
}


function install_emacs_tools {
  local name=emacs
  local group=351

  local config="${VIRTUAL_ENV:-.venv}"/postactivate.d/${group}-${name}.sh
  source ${config}

  # install Javascript/Typescript/Node tools
  pnpm add -g marked
  pnpm add -g @mermaid-js/mermaid-cli
  pnpm add -g vega-lite resvg-cli
}


function install_emacs_config {
  local self=$(readlink -f "${BASH_SOURCE[0]}")
  local dir=$(dirname $self)

  local name=emacs
  local group=351

  local config="${VIRTUAL_ENV:-.venv}"/postactivate.d/${group}-${name}.sh
  [[ ! -d $(dirname "${config}") ]] && mkdir -p $(dirname "${config}")
  cat <<EOD > "${config}"
#!/bin/bash

export PUPPETEER_EXECUTABLE_PATH=$(which chromium)
EOD
  chmod ugo+x "${config}"
  echo "${config}"
}


function __install_emacs {
  local self=$(readlink -f "${BASH_SOURCE[0]}"); dir=$(dirname $self)
  grep -E "^function [a-zA-Z0-9]" $self | cut -d' ' -f2 | while read cmd ;do
    $cmd $*
  done
}


if [ $_ != $0 ]; then
  # echo "Script is being sourced: list all functions"
  grep -E "^function [a-zA-Z0-9]" $(readlink -f "${BASH_SOURCE[0]}") | cut -d' ' -f2 | sed 's/()//'
else
  # echo "Script is a subshell: execute last function"
  $(grep -E "^function __" $(readlink -f "${BASH_SOURCE[0]}") | cut -d' ' -f2  | sed 's/()//' | tail -1) "$@"
fi
